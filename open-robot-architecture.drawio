  <diagram id="page2" name="2 Fleet network">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Open Robot · distributed fleet (fast layer + slow layer)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="owner" value="Owner / authority&lt;br&gt;issues credentials, can revoke" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="chain" value="Blockchain layer (slow)&lt;br&gt;identity · permissions · payments · audit" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="api" value="3rd-party APIs&lt;br&gt;(optional, sandboxed)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="80" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="R1" value="Robot A&lt;br&gt;node + wallet + local model" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="100" y="320" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="R2" value="Robot B&lt;br&gt;node + wallet + local model" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="500" y="320" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="R3" value="Robot C&lt;br&gt;node + wallet + local model" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="900" y="320" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="R4" value="Robot D&lt;br&gt;(offline / partitioned)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="100" y="540" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Fast layer = gossip + CRDT merge: always available, eventually consistent.&lt;br&gt;Slow layer = blockchain for identity, permissions, payments and audit; robots verify with light clients and signed, expiring credentials. During a partition, robots keep working on cached state and revocation lags." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="540" width="700" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="publish permissions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="owner" target="chain">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="revoke / e-stop&lt;br&gt;(when reachable)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="owner" target="R1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;dashed=1;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="R1" target="chain">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="light-client sync&lt;br&gt;(when reachable)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="R2" target="chain">
