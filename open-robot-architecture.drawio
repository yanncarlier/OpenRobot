          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="payment channel / signed vouchers (settle on-chain later)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;dashed=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="R1" target="R3">
